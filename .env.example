# Set only after inspecting the LIVE public Squarespace product path(s)
PUBLIC_SQUARESPACE_SHOP_URL=
# Explicit comma-separated hostnames, e.g. shop.makhex.com (set ONLY after verifying live public Squarespace site)
PUBLIC_SQUARESPACE_ALLOWED_HOSTS=
# Purchase releases also require checkout-approvals.ts and status Qualified.
# Needed only when Giscus GitHub App has access to this repo
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY_ID=
