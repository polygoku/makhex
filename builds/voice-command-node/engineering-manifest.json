  "preflight": [
    "Select an electrically compatible 3.3 V I2S microphone, amplifier and speaker; the speaker is included in the research BOM but its exact amp/connector pairing has not been qualified.",
    "Verify the board has sufficient PSRAM and use a hardware control with an unmistakable microphone-active indicator."
  ],
  "steps": [
    "Verify microphone and amplifier independently.",
    "Check memory and firmware SDK compatibility.",
    "Build push-to-talk with a visible recording indicator.",
    "Benchmark a small on-device command recognizer.",
    "Add error recovery and timeout handling."
  ],
  "acceptance": [
    "Record and play back intelligible audio without buffer underruns.",
    "Recognize three documented commands under a measured noise condition.",
    "The device visibly stops listening on timeout and never silently records."
  ],
  "agentTasks": [
    "Document separate microphone and amplifier bring-up procedures before the combined firmware.",
    "Record the recognition model, memory allocation and repeatable latency benchmark."
  ],
  "caution": "General-purpose offline speech recognition is not practical on all ESP32 modules; verify model memory needs."
