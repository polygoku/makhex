---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import {products} from '../../lib/catalog';
const cats=['All',...new Set(products.map(p=>p.category))];
---
<BaseLayout title="Maker Boards, Robotics & Components | MAKHEX" description="Research robotics and maker components for MAKHEX projects. Browse source-matched boards, actuators, sensors and prototyping parts; checkout is not yet enabled.">
  <section class="page-hero container maker-catalog-hero minimal-catalog-hero">
    <h1>Components.</h1>

  </section>
  <section class="container catalog-section">
    <div class="minimal-catalog-banner">
      <span>Free U.S. shipping</span>
      <span>Checkout coming soon</span>
      <a class="text-link" href="/parts-sources/">COMPARE ALL 30 SELLER SOURCES ↗</a>
    </div>
    <div class="catalog-toolbar">
      <div class="filters" aria-label="Filter component categories">
        {cats.map((cat,i)=><button type="button" class:list={['filter-button',{selected:i===0}]} data-category-filter={cat} aria-pressed={i===0}>{cat}</button>)}
      </div>
    </div>
    <div class="product-grid catalog-grid" id="catalog-grid">
      {products.map(p=><div data-category={p.category}><ProductCard product={p}/></div>)}
    </div>
  </section>
  <script is:inline src="/scripts/filter-components.js"></script>
</BaseLayout>
