---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import {products} from '../../lib/catalog';
const cats=['All',...new Set(products.map(p=>p.category))];
---
<BaseLayout title="ESP32 Components | MAKHEX" description="Browse research-stage ESP32 boards, sensors, displays and prototyping components with transparent qualification notes.">
<section class="page-hero container"><span class="eyebrow">THE PARTS DRAWER / TAKE A LOOK</span><h1>Find your<br/><em>next part.</em></h1><div class="page-hero-bottom"><p>Hardware mapped to something worth making. Every page shows project compatibility and variant-specific cautions.</p><span class="page-count">12 parts ideas, carefully labeled</span></div></section>
<section class="container catalog-section"><div class="catalog-toolbar"><div class="filters" aria-label="Filter component categories">{cats.map((cat,i)=><button type="button" class:list={['filter-button',{selected:i===0}]} data-category-filter={cat} aria-pressed={i===0}>{cat}</button>)}</div><div class="toolbar-note">Browsing only · no prices until verified</div></div>
<div class="product-grid catalog-grid" id="catalog-grid">{products.map(p=><div data-category={p.category}><ProductCard product={p}/></div>)}</div>
<aside class="disclosure-box"><span class="eyebrow">TRANSPARENCY FIRST</span><h2>Not a live checkout. Yet.</h2><p>All components are research candidates. MAKHEX will only enable Squarespace product links after a real supplier SKU, stock, specification, cost and fulfillment path are verified. Graphic illustrations are not actual product photos.</p></aside>
</section>
<script is:inline src="/scripts/filter-components.js"></script>
</BaseLayout>
