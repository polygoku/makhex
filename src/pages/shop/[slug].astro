---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {products,projects} from '../../lib/catalog';
import {commerceState} from '../../lib/commerce';
import type {Product} from '../../data/products';
import {stageFor,formatUsd} from '../../data/catalog-staging';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
interface Props{product:Product}
const {product}=Astro.props;
const checkout=commerceState(product);
const stage=stageFor(product.slug);
const related=projects.filter(p=>p.materials.some(m=>m.slug===product.slug)).slice(0,3);
const minimum=stage?Math.min(...stage.variants.map(v=>v.plannedRetailUsd)):null;
const ld={'@context':'https://schema.org','@type':'TechArticle',headline:stage?.supplierModel??product.title,description:product.description,author:{'@type':'Organization',name:'MAKHEX'},url:'https://makhex.com/shop/'+product.slug+'/',about:{'@type':'Thing',name:stage?.supplierModel??product.title}};
---
<BaseLayout title={(stage?.supplierModel??product.title)+' | MAKHEX'} description={product.description}>
  <div class="container breadcrumb">
    <a href="/">HOME</a><span>/</span><a href="/shop/">COMPONENTS</a><span>/</span><span>{product.title.toUpperCase()}</span>
  </div>
  <section class="container detail-grid clean-product-detail">
    <div class="component-main-visual">
      <ProductVisual product={product} large/>
      <p class="quiet-image-caption">Illustration</p>
    </div>
    <div class="detail-content">
      <h1>{stage?.supplierModel??product.title}</h1>
      <p class="detail-description">{product.description}</p>
      <div class="clean-product-price">{minimum!==null?formatUsd(minimum):'Price pending'}{stage&&stage.variants.length>1&&<span>from</span>}</div>
      <p class="clean-shipping">Free U.S. shipping</p>
      {stage&&stage.variants.length>1&&<div class="clean-variant-options">
        {stage.variants.map(v=><div><span>{v.title}</span><strong>{formatUsd(v.plannedRetailUsd)}</strong></div>)}
      </div>}
      <div class="clean-product-action">
        {checkout.kind==='ready'
          ?<a class="btn btn-primary" href={checkout.url} rel="noopener noreferrer">Buy on MAKHEX ↗</a>
          :<button class="btn btn-muted" type="button" disabled>Coming soon</button>}
        {checkout.kind!=='ready'&&<p>Ordering opens after fulfillment testing.</p>}
      </div>
      <div class="clean-product-specs">
        {product.specs.map(spec=><div>{spec}</div>)}
      </div>
      {stage?.technicalGate==='HOLD'&&<p class="clean-compatibility">Compatibility is still being checked for this model.</p>}
    </div>
  </section>
  {related.length>0&&<section class="section container">
    <div class="section-heading compact"><h2>Build with it.</h2><a class="text-link" href="/projects/">ALL PROJECTS ↗</a></div>
    <div class="project-grid">{related.map(p=><ProjectCard project={p}/>)}</div>
  </section>}
  <script type="application/ld+json" set:html={JSON.stringify(ld)}/>
</BaseLayout>
