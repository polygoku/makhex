---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductPhoto from '../../components/ProductPhoto.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {products,projectsNewestFirst} from '../../lib/catalog';
import {commerceState} from '../../lib/commerce';
import type {Product} from '../../data/products';
import {stageFor,formatUsd} from '../../data/catalog-staging';
import {supplierFor} from '../../data/supplier-matches';
const microduckResearchSlugs=new Set(['feetech-hd1910','radxa-zero-3w','microduck-hat','microduck-imu','imx219-160-camera','vl53l5cx-v2','npf550-power-kit','bearing-6700','bearing-et2216','bearing-623zz','microduck-printed-parts','microduck-fasteners','amp20-servo-cables','microduck-wiring-kit']);
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
interface Props{product:Product}
const {product}=Astro.props;
const checkout=commerceState(product);
const stage=stageFor(product.slug);
const source=supplierFor(product.slug);
const related=projectsNewestFirst.filter(p=>p.materials.some(m=>m.slug===product.slug)).slice(0,3);
const minimum=stage?Math.min(...stage.variants.map(v=>v.plannedRetailUsd)):null;
const ld={'@context':'https://schema.org','@type':'TechArticle',headline:stage?.supplierModel??product.title,description:product.description,author:{'@type':'Organization',name:'MAKHEX'},url:'https://makhex.com/shop/'+product.slug+'/',about:{'@type':'Thing',name:stage?.supplierModel??product.title}};
const labels:Record<string,string>={EXACT_SPEC:'Exact model / stated dimensions',SELECT_VARIANT:'Select matching option',COMPATIBILITY_REVIEW:'Check compatibility',CUSTOM_ORDER:'Custom fabrication request'};
---
<BaseLayout title={(stage?.supplierModel??product.title)+' | MAKHEX'} description={product.description}>
  <div class="container breadcrumb">
    <a href="/">HOME</a><span>/</span><a href="/shop/">COMPONENTS</a><span>/</span><span>{product.title.toUpperCase()}</span>
  </div>
  <section class="container detail-grid clean-product-detail">
    <div class="component-main-visual">
      <ProductPhoto product={product} large gallery/>
      <p class="quiet-image-caption">{microduckResearchSlugs.has(product.slug)?'MAKHEX technical illustration · no supplier image or exact option verified':'Component reference image · verify actual retailer variation'}</p>
    </div>
    <div class="detail-content">
      <h1>{stage?.supplierModel??product.title}</h1>
      <p class="detail-description">{product.description}</p>
      <div class="clean-product-price">{minimum!==null?'MAKHEX plan '+formatUsd(minimum):'MAKHEX sourcing review'}{stage&&stage.variants.length>1&&<span>from</span>}</div>
      {minimum!==null&&<p class="clean-compatibility">MAKHEX catalog planning price only, not a verified supplier offer or checkout quote. Retailer prices and shipping appear on their sites.</p>}
      <p class="clean-shipping">MAKHEX offers free U.S. shipping after supplier qualification. You buy from MAKHEX, not from individual component sellers.</p>
      {stage&&stage.variants.length>1&&<div class="clean-variant-options">
        {stage.variants.map(v=><div><span>{v.title}</span><strong>{formatUsd(v.plannedRetailUsd)}</strong></div>)}
      </div>}
      <div class="clean-product-action" data-cart-product={product.slug}>
        {stage&&stage.variants.length>1&&<label class="cart-choice-label">Choose a component option<select data-cart-choice aria-label="Component option">{stage.variants.map(v=><option value={v.title}>{v.title}</option>)}</select></label>}
        <button class="btn btn-primary" type="button" data-cart-add data-cart-slug={product.slug} data-cart-option={stage?.variants[0]?.title??'Option pending'} data-cart-quantity="1">ADD TO PARTS LIST +</button>
        <a class="btn btn-outline" href="/cart/">CHECK OUT WITH MAKHEX →</a><p>Build a single MAKHEX basket. Any sourcing exception is reviewed by our store before final payment.</p>
        {checkout.kind==='ready'&&<a class="text-link" href={checkout.url} rel="noopener noreferrer">OPEN APPROVED MAKHEX STORE PRODUCT ↗</a>}
      </div>
      <div class="clean-product-specs">
        {product.specs.map(spec=><div>{spec}</div>)}
      </div>
      {stage?.technicalGate==='HOLD'&&<p class="clean-compatibility">Compatibility is still being checked for this model.</p>}
    </div>
  </section>
  <section class="section container supplier-compare" id="buying-options"><details class="supplier-last-resort"><summary>External alternatives — only if MAKHEX cannot fulfill this component</summary>
    <span class="eyebrow">SOURCE MATCHES / ACTUAL SELLER LINKS</span>
    <h2>Last-resort source references.</h2>
    <p class="supplier-intro"><strong>Required:</strong> {source?.required} {source?.notes}</p>
    <p class="supplier-disclosure">MAKHEX sources parts for your order. These references are offered only if MAKHEX cannot fulfill the part and you decide to source it yourself. Never required for standard MAKHEX checkout.</p>
    <div class="supplier-options">
      {source?.offers.map(offer=><article class="supplier-option" data-supplier-match={offer.match} data-supplier-project={offer.project??''}>
        <div class="supplier-option-heading"><strong>{offer.seller}</strong><span>{labels[offer.match]}</span></div>
        <h3>{offer.label}</h3>
        <p>{offer.note}</p>
        {offer.project&&<small>Specific to: {offer.project.replaceAll('-',' ')}</small>}
        <a class="text-link" target="_blank" rel="noopener noreferrer" href={offer.url}>OPEN {offer.seller.toUpperCase()} PRODUCT / COMPARISON ↗</a>
      </article>)}
    </div>
    <p class="supplier-end-note">Part source not right or out of stock? <a href={'/projects/'+(related[0]?.slug??'microduck-robot')+'/#discussion'}>Suggest a verified matching supplier in the project discussion</a>.</p>
    <a class="text-link" href="/parts-sources/">VIEW EXTERNAL SOURCE REFERENCES ↗</a></details>
  </section>
  {related.length>0&&<section class="section container">
    <div class="section-heading compact"><h2>Build with it.</h2><a class="text-link" href="/projects/">ALL PROJECTS ↗</a></div>
    <div class="project-grid">{related.map(p=><ProjectCard project={p}/>)}</div>
  </section>}
  <script type="application/ld+json" set:html={JSON.stringify(ld)}/>
</BaseLayout>
<style>
.supplier-compare{border-top:1px solid #d5d7c8;padding-top:3rem}
.supplier-compare h2{font-size:clamp(1.8rem,4vw,3.2rem);margin:.5rem 0 1rem}
.supplier-intro,.supplier-disclosure,.supplier-end-note{max-width:62rem;line-height:1.7}
.supplier-disclosure{color:#665e51}
.supplier-options{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:1rem;margin:1.7rem 0}
.supplier-option{padding:1.25rem;border:1px solid #d8c6ad;background:#fffaf2;border-radius:14px;display:flex;flex-direction:column;gap:.65rem;overflow-wrap:anywhere}
.supplier-option-heading{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.3rem}
.supplier-option-heading strong{color:#1d4536}
.supplier-option-heading span{font-size:.76rem;letter-spacing:.02em;color:#8d4d30}
.supplier-option h3{font-size:1.12rem;margin:0}
.supplier-option p{line-height:1.55;font-size:.9rem;margin:0;flex:1}
.supplier-option small{display:block;color:#695b4e}
.supplier-option a{font-size:.83rem;line-height:1.5;margin-top:.35rem}
@media(max-width:640px){.supplier-compare{padding-top:2rem}}
</style>