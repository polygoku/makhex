---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Discussion from '../../components/Discussion.astro';
import {products,projects} from '../../lib/catalog';
import {commerceState} from '../../lib/commerce';
import discussionLinks from '../../data/discussion-links.json';
import type {Product} from '../../data/products';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
interface Props{product:Product}
const {product}=Astro.props;
const checkout=commerceState(product);
const related=projects.filter(p=>p.materials.some(m=>m.slug===product.slug)).slice(0,3);
const ld={'@context':'https://schema.org','@type':'TechArticle',headline:product.title,description:product.description,author:{'@type':'Organization',name:'MAKHEX'},url:'https://makhex.com/shop/'+product.slug+'/'};
---
<BaseLayout title={product.title+' | MAKHEX'} description={product.description}>
<div class="container breadcrumb"><a href="/">HOME</a><span>/</span><a href="/shop/">COMPONENTS</a><span>/</span><span>{product.title.toUpperCase()}</span></div>
<section class="container detail-grid"><div><ProductVisual product={product} large/><div class="visual-legend"><span>CONCEPT ILLUSTRATION • NOT A LISTING PHOTO</span><span>FIG / MX</span></div></div>
<div class="detail-content"><span class="eyebrow">{product.category.toUpperCase()} / COMPONENT FILE</span><h1>{product.title}</h1><p class="detail-subhead">{product.descriptor}</p>
<div class="detail-status"><span class="live-dot amber"></span> {checkout.kind==='ready'?'QUALIFIED / SQUARESPACE CHECKOUT':'RESEARCH CANDIDATE / NOT FOR SALE'}</div><p class="detail-description">{product.description}</p>
<div class="spec-list"><span class="eyebrow">CAPABILITIES / CLASS LEVEL</span>{product.specs.map((s,i)=><div><span>0{i+1}</span><p>{s}</p><span>↗</span></div>)}</div>
<div class="purchase-panel"><span class="eyebrow">PURCHASING</span>{checkout.kind==='ready'?<a class="btn btn-primary" href={checkout.url} rel="noopener noreferrer">VIEW PRODUCT ON SQUARESPACE ↗</a>:<button class="btn btn-muted" type="button" disabled>CHECKOUT COMING SOON</button>}
<small>{checkout.kind==='ready'?'Checkout takes place on the separate MAKHEX Squarespace site.':checkout.reason}</small></div>
<div class="warning-box"><strong>VARIANT VERIFICATION REQUIRED</strong><p>{product.notes}</p></div></div></section>
{related.length>0&&<section class="section container"><div class="section-heading compact"><div><span class="eyebrow">FROM PART TO PROJECT</span><h2>Build with this.</h2></div><a class="text-link" href="/projects/">ALL PROJECTS ↗</a></div><div class="project-grid">{related.map(p=><ProjectCard project={p}/>)}</div></section>}
<div class="container"><Discussion context={product.title} discussionUrl={(discussionLinks.products as Record<string,string>)[product.slug]} discussionTitle={"Component: "+product.title+" - wiring, firmware, parts"}/></div><script type="application/ld+json" set:html={JSON.stringify(ld)}/>
</BaseLayout>
