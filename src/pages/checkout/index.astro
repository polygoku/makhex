---
import BaseLayout from '../../layouts/BaseLayout.astro';
const states='AL AK AZ AR CA CO CT DE DC FL GA HI ID IL IN IA KS KY LA ME MD MA MI MN MS MO MT NE NV NH NJ NM NY NC ND OH OK OR PA RI SC SD TN TX UT VT VA WA WV WI WY'.split(' ');
---
<BaseLayout noindex title="Checkout with MAKHEX | Build your kit" description="Keep your full project parts order with MAKHEX. We review supplier exceptions and send secure MAKHEX payment instructions when the order is ready.">
 <div class="container breadcrumb"><a href="/">HOME</a><span>/</span><a href="/cart/">PARTS CART</a><span>/</span><span>CHECKOUT</span></div>
 <section class="container makhex-checkout-hero">
   <span class="eyebrow">MAKHEX / ONE CART / ONE SELLER</span>
   <h1>Checkout with MAKHEX.</h1>
   <p>Choose your project and parts; MAKHEX handles sourcing and fulfillment. <strong>No external supplier checkout required.</strong></p>
   <div class="makhex-checkout-steps"><span>01 / Review basket</span><span>02 / Submit order</span><span>03 / Approve sourcing exceptions</span><span>04 / Pay securely</span></div>
 </section>
 <section class="container makhex-checkout-grid" aria-label="MAKHEX order checkout">
   <div class="makhex-checkout-panel">
     <span class="eyebrow">01 / YOUR PARTS</span>
     <h2>Keep everything together.</h2>
     <div id="makhex-checkout-lines" class="checkout-items" aria-live="polite"><p>Loading your MAKHEX basket…</p></div>
     <p class="checkout-costs" id="makhex-checkout-plan">Final price will be confirmed before payment.</p>
     <p class="checkout-support">Build files, supplier compatibility and all your requested quantities are retained in one order. You will not be redirected to an individual supplier.</p>
     <a class="text-link" href="/cart/">EDIT PARTS IN CART ↗</a>
   </div>
   <div class="makhex-checkout-panel checkout-form-panel">
     <span class="eyebrow">02 / CUSTOMER &amp; U.S. SHIPPING REGION</span>
     <h2>Request checkout.</h2>
     <p>To avoid charging for unavailable supplier options, we confirm unusual sourcing or pricing before sending a payment link from our Squarespace-powered MAKHEX store.</p>
     <form id="makhex-order-request-form" class="makhex-form">
       <label>Contact email (manual order correspondence) <input name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required/></label>
       <div class="checkout-address-grid">
        <label>Ship to state <select name="shippingState" required><option value="">Select state</option>{states.map(s=><option value={s}>{s}</option>)}</select></label>
        <label>ZIP code <input name="shippingZip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="11021" autocomplete="postal-code" required/></label>
       </div>
       <p class="checkout-private">We only ask for your U.S. shipping region to qualify parts. The full address and payment details are entered later in secure MAKHEX payment checkout, not stored here.</p>
       <label class="checkout-consent"><input name="acceptTerms" type="checkbox" required/> I understand this submits one MAKHEX order for review and <strong>does not charge my card yet</strong>. I will approve the final amount at secure MAKHEX payment checkout.</label>
       <div id="makhex-checkout-turnstile" aria-label="Anti-spam verification"></div>
       <button class="btn btn-primary checkout-cta" type="submit" disabled>PLACE MY MAKHEX ORDER →</button>
       <p id="makhex-checkout-notice" role="status" aria-live="polite">Complete the human check before submitting.</p>
     </form>
     <div id="makhex-checkout-success" class="checkout-confirmation" hidden>
       <span class="eyebrow">YOUR ORDER HAS BEEN RECEIVED</span>
       <h3 id="makhex-checkout-id"></h3>
       <p>MAKHEX is sourcing your full basket. No charge has been made. <strong>Save the private order-status link now</strong>—automatic email notifications are not configured yet. Use the link to see sourcing decisions and payment status.</p>
       <a id="makhex-checkout-status-link" class="btn btn-primary" href="/checkout/status/">VIEW MY ORDER STATUS ↗</a>
       <button id="makhex-checkout-copy" class="btn btn-outline" type="button">COPY PRIVATE ORDER LINK</button>
       <p id="makhex-checkout-copy-result" role="status"></p>
     </div>
   </div>
 </section>
 <script is:inline src="/scripts/makhex-checkout.js?v=first-party-20261027"></script>
</BaseLayout>
<style>
.makhex-checkout-hero{padding-top:clamp(2rem,5vw,4rem);padding-bottom:2rem}.makhex-checkout-hero h1{font-size:clamp(2.2rem,5.7vw,5rem);line-height:1.04;margin:.65rem 0 1rem}.makhex-checkout-hero p{max-width:62rem;font-size:1.05rem}.makhex-checkout-steps{display:flex;flex-wrap:wrap;gap:.55rem;margin:1.6rem 0}.makhex-checkout-steps span{font-size:.75rem;border:1px solid #d5c8b5;border-radius:9px;padding:.65rem;background:#fffaf4}.makhex-checkout-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1rem;padding-bottom:4rem}.makhex-checkout-panel{padding:clamp(1.2rem,2.5vw,2rem);border:1px solid #dec7ab;border-radius:17px;background:#fffaf2}.makhex-checkout-panel h2{font-size:clamp(1.45rem,3vw,2.15rem);margin:.4rem 0 1rem}.makhex-checkout-panel p{line-height:1.6}.checkout-items{display:grid;gap:.5rem}.checkout-item{padding:.9rem 0;border-bottom:1px solid #e0d2bd;display:flex;justify-content:space-between;gap:.7rem}.checkout-item strong{font-size:.92rem}.checkout-item span{color:#605c51;font-size:.8rem}.checkout-costs{font-weight:700;color:#315b45}.checkout-support,.checkout-private{color:#625f58;font-size:.85rem}.makhex-form{display:grid;gap:1rem}.makhex-form label{font-weight:650;font-size:.87rem;display:grid;gap:.4rem}.makhex-form input:not([type=checkbox]),.makhex-form select{box-sizing:border-box;width:100%;padding:.85rem;border-radius:9px;border:1px solid #baa998;background:#fff;color:#27352c;font:inherit}.checkout-address-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.makhex-form .checkout-consent{display:flex;gap:.7rem;align-items:start;font-weight:400;line-height:1.5}.checkout-consent input{margin-top:.3rem;accent-color:#b95a37}.checkout-cta{width:100%;white-space:normal}.checkout-confirmation{border-top:1px solid #d7c5b1;margin-top:1rem;padding-top:1rem}.checkout-confirmation .btn{margin:.5rem}.checkout-confirmation h3{font-size:1.6rem}.makhex-checkout-panel a{overflow-wrap:anywhere}
@media(max-width:760px){.makhex-checkout-grid{grid-template-columns:1fr}.checkout-address-grid{grid-template-columns:1fr 1fr}.makhex-checkout-hero h1{font-size:2.6rem}}
</style>