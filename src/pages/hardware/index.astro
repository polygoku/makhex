---
import Base from '../../layouts/Base.astro';import {products,categories} from '../../data/catalog';
---
<Base title="Hardware library"><section class="page-banner"><div class="wrap"><div class="eyebrow">HARDWARE LIBRARY / 02</div><h1>Parts with purpose<span class="lime">.</span></h1><p>Research-stage components for hands-on ESP32 projects.</p></div></section><section class="section"><div class="wrap"><div class="filter-bar"><span>EXPLORE {products.length} COMPONENTS</span><div class="category-filters"><button type="button" class="active" data-category="all">All</button>{categories.map(c=><button type="button" data-category={c}>{c}</button>)}</div></div><div class="hardware-grid catalog-grid">{products.map((p,i)=><a data-kind={p.kind} class="hardware-card" href={'/hardware/'+p.slug+'/'}><div class={'mini-board mini-'+i%4}><span class="mini-board-core">{p.kind.slice(0,3).toUpperCase()}</span></div><span class="hardware-kind">{p.kind}</span><h2>{p.name}</h2><p>{p.summary}</p><span class="link-arrow">Technical details ↗</span></a>)}</div></div></section><script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-category]');buttons.forEach(btn=>btn.addEventListener('click',()=>{buttons.forEach(b=>b.classList.toggle('active',b===btn));const selected=btn.dataset.category;document.querySelectorAll<HTMLElement>('[data-kind]').forEach(card=>card.hidden=selected!=='all'&&card.dataset.kind!==selected)}));</script></Base>