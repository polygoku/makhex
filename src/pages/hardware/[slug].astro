---
import Base from '../../layouts/Base.astro';import Discussion from '../../components/Discussion.astro';import {products} from '../../data/catalog';import {projects} from '../../data/projects';
export function getStaticPaths(){return products.map(p=>({params:{slug:p.slug},props:{item:p}}))};
const {item}=Astro.props;const builds=projects.filter(p=>p.parts.includes(item.slug));const shopUrl=item.shopUrl;
---
<Base title={item.name} description={item.summary}><section class="page-banner detail-banner"><div class="wrap"><a class="back-link" href="/hardware/">← Hardware library</a><div class="eyebrow">{item.kind.toUpperCase()} / RESEARCH COLLECTION</div><h1>{item.name}<span class="lime">.</span></h1><p>{item.summary}</p></div></section><section class="section"><div class="wrap detail-grid"><article class="longform"><div class="eyebrow">COMPONENT OVERVIEW</div><h2>{item.tag}<span class="lime">.</span></h2><p>{item.summary}</p><h3>Technical checkpoints</h3><ul class="specs">{item.specs.map((s:string)=><li>{s}</li>)}</ul><h3>Where it fits</h3><div class="tag-row">{item.applications.map((a:string)=><span class="tag">{a}</span>)}</div><h3>Build with this</h3>{builds.length?builds.map(p=><a class="related" href={'/projects/'+p.slug+'/'}>{p.title}<span>↗</span></a>):<p>No published build mapping yet.</p>}</article><aside class="bom"><div class="eyebrow">RESEARCH-STAGE HARDWARE</div><h2>Ready to build?</h2><p>We are verifying seller listings, specifications and fulfillment before enabling checkout.</p>{shopUrl?<a class="btn btn-lime" href={shopUrl} target="_blank" rel="noopener">Open Squarespace checkout ↗</a>:<span class="disabled-checkout">SHOP LINK COMING SOON</span>}<div class="bom-foot">Prices, availability and compatibility are not yet verified. No payment is taken here.</div></aside></div><div class="wrap"><Discussion title={item.name}/></div></section></Base>