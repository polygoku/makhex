---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Your Parts Cart | MAKHEX" description="Add individual ESP32 components or an entire project BOM. Cart planning is available, but payment checkout requires supplier verification.">
 <div class="container breadcrumb"><a href="/">HOME</a><span>/</span><span>PARTS CART</span></div>
 <section class="container cart-page">
  <div class="cart-heading"><div><span class="eyebrow">MAKHEX / PARTS CART</span><h1>Build your kit.</h1><p>Collect components or add every part for a project in one click. Your cart is saved locally in this browser.</p></div><div class="cart-heading-side"><span data-cart-lines-count>Loading…</span><a class="text-link" href="/projects/">BROWSE BUILDS ↗</a></div></div>
  <div class="cart-body-grid">
   <div class="cart-lines" data-cart-lines aria-live="polite"><p>Loading parts…</p></div>
   <aside class="cart-summary"><span class="eyebrow">YOUR BUILD BASKET</span><h2>Parts summary</h2><strong class="cart-total" data-cart-total>Loading…</strong><p>Indicative prices are not offers. Exact part variants, supplier stock, returns and U.S. shipping must pass verification.</p><button class="btn btn-muted cart-checkout-disabled" type="button" disabled aria-disabled="true">Checkout not available yet</button><p class="cart-checkout-note">Squarespace checkout and Doroppu fulfillment have not passed end-to-end order verification. No payment information is collected here.</p><div class="cart-summary-actions"><button class="btn btn-outline" type="button" data-cart-copy>Copy parts list</button><button class="cart-clear" type="button" data-cart-clear>Clear cart</button></div><p data-cart-flash role="status" aria-live="polite"></p></aside>
  </div>
 </section>
</BaseLayout>
