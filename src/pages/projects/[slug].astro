---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Discussion from '../../components/Discussion.astro';
import ProductCard from '../../components/ProductCard.astro';
import {projects,productBySlug} from '../../lib/catalog';
import discussionLinks from '../../data/discussion-links.json';
import type{Project} from '../../data/projects';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
interface Props{project:Project}
const {project}=Astro.props;
const materials=project.materials.map(m=>({...m,product:productBySlug(m.slug)}));
const total=project.materials.reduce((n,m)=>n+m.qty,0);
const ld={'@context':'https://schema.org','@type':'HowTo',name:project.title,description:project.summary,step:project.steps.map((text,i)=>({'@type':'HowToStep',position:i+1,text})),url:'https://makhex.com/projects/'+project.slug+'/'};
---
<BaseLayout title={project.title+' | MAKHEX'} description={project.summary}>
<div class="container breadcrumb"><a href="/">HOME</a><span>/</span><a href="/projects/">PROJECTS</a><span>/</span><span>{project.number}</span></div>
<section class="project-detail-hero container"><div><span class="eyebrow">MAKHEX PROJECT / {project.number} • {project.eyebrow}</span><h1>{project.title}<span class="heading-star">✳</span></h1><p>{project.summary}</p><div class="project-tag-row"><span>{project.level}</span><span>{project.time}</span><span>{project.category}</span></div><a class="btn btn-primary" href="#bill-of-materials">SEE THE PARTS LIST ↓</a></div>
<div class="project-detail-poster"><div class="poster-grid"></div><span class="poster-overline">IN / {project.signal}</span><div class="poster-pulse">↳<span>◉</span></div><div class="poster-bottom"><span>OUT / {project.output}</span><strong>MX/{project.number}</strong></div></div></section>
<section class="container project-body-grid"><div><div class="content-section" id="bill-of-materials"><span class="eyebrow">01 / BILL OF MATERIALS</span><h2>What goes in.</h2><p>Mapped component candidates. Compatibility and suppliers await validation.</p>
<div class="bom-table"><div class="bom-row bom-heading"><span>COMPONENT</span><span>ROLE</span><span>QTY</span></div>{materials.map(m=><div class="bom-row"><span>{m.product?<a href={'/shop/'+m.slug+'/'}>{m.product.title} ↗</a>:m.slug}</span><span>{m.why}</span><strong>{String(m.qty).padStart(2,'0')}</strong></div>)}</div>
<div class="bom-total"><span>{materials.length} UNIQUE PART TYPES</span><span>{total} ITEMS</span></div></div>
<div class="content-section"><span class="eyebrow">02 / THE APPROACH</span><h2>Build sequence.</h2><ol class="steps-list">{project.steps.map((s,i)=><li><span>{String(i+1).padStart(2,'0')}</span><p>{s}</p></li>)}</ol></div>
<div class="warning-box prominent"><strong>⚑ ENGINEERING NOTE</strong><p>{project.caution}</p><small>Concept-stage plan; bench validation and firmware QA pending.</small></div></div>
<aside class="project-aside"><div class="aside-card"><span class="eyebrow">THE QUICK SPEC</span><div><span>STATUS</span><strong>BLUEPRINT</strong></div><div><span>LEVEL</span><strong>{project.level.toUpperCase()}</strong></div><div><span>TIME</span><strong>{project.time.toUpperCase()}</strong></div><div><span>TECH</span><strong>{project.tech.join(' / ')}</strong></div></div>
<div class="aside-help"><span>FOUND A BETTER WAY?</span><p>Share a correction, alternative firmware or tested supplier option.</p><a class="text-link" target="_blank" rel="noopener noreferrer" href="https://github.com/polygoku/makhex/discussions">OPEN BUILD DISCUSSIONS ↗</a></div></aside></section>
<section class="section container"><div class="section-heading compact"><div><span class="eyebrow">COMPATIBLE CANDIDATES</span><h2>The building blocks.</h2></div><a class="text-link" href="/shop/">FULL CATALOG ↗</a></div><div class="product-grid">{materials.map(m=>m.product&&<ProductCard product={m.product}/>)}</div></section>
<div class="container"><Discussion context={project.title} discussionUrl={(discussionLinks.projects as Record<string,string>)[project.slug]} discussionTitle={"Project: "+project.title+" - BOM, firmware, build notes"}/></div><script type="application/ld+json" set:html={JSON.stringify(ld)}/></BaseLayout>
