---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Discussion from '../../components/Discussion.astro';
import ProductCard from '../../components/ProductCard.astro';
import MosaicoHardwareBOM from '../../components/MosaicoHardwareBOM.astro';
import MicroduckResources from '../../components/MicroduckResources.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import BuildPartsChecklist from '../../components/BuildPartsChecklist.astro';
import {projects,productBySlug} from '../../lib/catalog';
import type{Project} from '../../data/projects';
import {buildReferences} from '../../data/build-references';
import {projectGuides} from '../../data/project-guides';
import {plannedVariantForProject,projectBomMissingParts,formatUsd} from '../../data/catalog-staging';
import {offersFor} from '../../data/supplier-matches';
import {isMakhexAliExpress,preferredExternalOffer} from '../../data/sourcing-policy';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
interface Props{project:Project}
const {project}=Astro.props;
const isMicroduck=project.slug==='microduck-robot';
const reference=buildReferences[project.slug];
const guide=projectGuides[project.slug];
const buildRepo='https://github.com/polygoku/makhex/tree/main/builds/'+project.slug;
const agentFile='https://github.com/polygoku/makhex/blob/main/builds/'+project.slug+'/README.md';
const materials=project.materials.map(m=>({...m,product:productBySlug(m.slug),ali:isMakhexAliExpress(m.slug),direct:preferredExternalOffer(m.slug,project.slug),planned:plannedVariantForProject(m.slug,project.slug),offers:offersFor(m.slug,project.slug)}));
const aliItems=materials.filter(m=>m.ali);
const aliQuantity=aliItems.reduce((n,m)=>n+m.qty,0);
const externalItems=materials.filter(m=>!m.ali);
const plannedPartsSubtotal=materials.reduce((sum,m)=>sum+(m.planned?.plannedRetailUsd??0)*m.qty,0);
const missingParts=projectBomMissingParts[project.slug]??[];
const total=project.materials.reduce((n,m)=>n+m.qty,0);
const ld={'@context':'https://schema.org','@type':'HowTo',name:project.title,description:project.summary,step:project.steps.map((text,i)=>({'@type':'HowToStep',position:i+1,text})),url:'https://makhex.com/projects/'+project.slug+'/'};
---
<BaseLayout title={project.title+' | MAKHEX'} description={project.summary}>
<div class="container breadcrumb"><a href="/">HOME</a><span>/</span><a href="/projects/">PROJECTS</a><span>/</span><span>{project.number}</span></div>
<section class="project-detail-hero container"><div><span class="eyebrow">MAKHEX PROJECT / {project.number} • {project.eyebrow}</span><h1>{project.title}<span class="heading-star">✳</span></h1><p>{project.summary}</p><div class="project-tag-row"><span>{project.level}</span><span>{project.time}</span><span>{project.category}</span></div><a class="btn btn-primary" href="#bill-of-materials">SEE THE PARTS LIST ↓</a> <a class="btn btn-outline" href={`/projects/${project.slug}.csv`}>DOWNLOAD BOM CSV ↓</a> <a class="btn btn-outline" href={aliItems.length?"/cart/":"#bill-of-materials"}>{aliItems.length?"MAKHEX ALIEXPRESS CART":"SEE EXTERNAL PART LINKS"} ↗</a> <a class="btn btn-outline" href="#discussion">JOIN DISCUSSION ↓</a>{project.slug==='mosaico-learning-assistant'&&<a class="btn btn-outline" href="#video">WATCH DEMO ▶</a>}{isMicroduck&&<a class="btn btn-outline" href="#microduck-demo">WATCH REAL ROBOT ▶</a>}</div>
{reference ? <div class="project-detail-poster real-reference-poster">
<img class="real-reference-photo" src={reference.image} alt={reference.alt} width="1080" height="760" loading="eager"/>

<span class="detail-poster-caption real-reference-poster-caption">Photo credit: {reference.builder}</span>
</div> : isMicroduck ? <div class="project-detail-poster real-reference-poster microduck-source-hero"><img class="real-reference-photo" src="/demo/microduck/microduck-hero.jpg" alt="Video still of Microduck, the real 15-servo walking robot built by kissqy" width="960" height="540" loading="eager"/><span class="detail-poster-caption real-reference-poster-caption">Real robot demonstration · original creator kissqy</span></div> : project.slug==='mosaico-learning-assistant' ? <div class="project-detail-poster build11-approved-hero"><img class="real-reference-photo" src="/demo/build11-english-lifestyle-wide.jpg" alt="AI-generated English learning assistant concept with a handheld touchscreen scanning an algebra worksheet; not a product photo" width="1122" height="701" loading="eager"/><span class="detail-poster-caption">English-language concept illustration · not actual hardware photography</span></div> : <div class="project-detail-poster"><ProjectArtwork project={project}/><span class="detail-poster-caption">Concept sketch · proposed build, not yet bench-verified</span></div>}</section>
{project.slug==='mosaico-learning-assistant'&&<section class="container project-demo" id="video">
 <div class="project-demo-intro"><div><span class="eyebrow">BUILD 11 / ON-SITE VIDEO</span><h2>Photo. Choose. Explain. Ask again.</h2><p>Watch an English-language concept walkthrough directly on MAKHEX. This visual simulation illustrates the workflow; it is <strong>not</strong> a recording of working MAKHEX firmware or the original demonstration.</p></div></div>
 <div class="project-demo-local">
   <video controls playsinline preload="metadata" poster="/demo/build11-english-lifestyle-wide.jpg" width="1280" height="720" aria-label="English workflow concept animation for AI Photo and Voice Learning Assistant">
     <source src="/demo/build11-en-concept.mp4" type="video/mp4"/>
     <track kind="captions" src="/demo/build11-en.vtt" srclang="en" label="English" default/>
     Your browser does not support HTML5 video.
   </video>
   <span class="project-demo-local-note">Illustrative walkthrough, not bench-verified device footage · U.S. English</span>
 </div>
 <div class="build11-approved-gallery" aria-label="English-language visual walkthrough">
  <figure class="build11-approved-main"><img src="/demo/build11-english-lifestyle.jpg" alt="AI-generated concept image of a student using a handheld touchscreen learning assistant to photograph an algebra worksheet, with English interface labels" loading="lazy" width="1122" height="1402"/><figcaption>Featured / English-language learning assistant concept</figcaption></figure>
  <div class="project-demo-stills build11-photo-stills">
   <figure><img src="/demo/build11-english-capture.jpg" alt="AI-generated mockup with an English question picker for an algebra worksheet" loading="lazy" width="941" height="1672"/><figcaption>01 / Capture &amp; select</figcaption></figure>
   <figure><img src="/demo/build11-english-explanation.jpg" alt="AI-generated mockup showing the steps for solving two x plus six equals fourteen" loading="lazy" width="941" height="1672"/><figcaption>02 / Explain step by step</figcaption></figure>
   <figure><img src="/demo/build11-english-followup.jpg" alt="AI-generated mockup showing the English voice follow-up question and an explanation" loading="lazy" width="941" height="1672"/><figcaption>03 / Ask a voice follow-up</figcaption></figure>
  </div>
 </div>
 <p class="project-demo-origin">These visuals are AI-generated English-language illustrations, not photographs or screenshots of validated firmware. For archival context, the original real-device demonstration is referenced in the <a href={buildRepo} rel="noopener noreferrer" target="_blank">GitHub build notes</a>. That footage is not included here because the creator has not provided commercial reuse rights.</p>
</section>}
{isMicroduck&&<MicroduckResources/>}
<section class="container guide-intro"><div class="content-section"><span class="eyebrow">WHAT YOU WILL MAKE</span><h2>The idea, in practice.</h2><p class="guide-overview">{guide.overview}</p><div class="guide-use-cases"><h3>Where it is useful</h3><ul>{guide.useCases.map(item=><li>{item}</li>)}</ul></div></div><div class="guide-links"><span class="eyebrow">SOURCE AND WALKTHROUGH</span><h3>Build with an open repo.</h3>{guide.source?<p>Engineering source and license details are in our GitHub build notes. This is a research build, not a finished MAKHEX product.</p>:<p>MAKHEX is a proposed adaptation. Reference media is credited to its original creator, not a claim of a finished MAKHEX prototype.</p>}<a class="btn btn-primary" href={buildRepo} target="_blank" rel="noopener noreferrer">MAKHEX PROJECT REPO →</a><a class="btn btn-outline" href={agentFile} target="_blank" rel="noopener noreferrer">AI AGENT BUILD INSTRUCTIONS ↗</a>{reference&&<a class="text-link" href={reference.sourceUrl} target="_blank" rel="noopener noreferrer">ORIGINAL CREATOR REPO ↗</a>}{guide.video&&!guide.source&&<a class="text-link" href={guide.video.url} target="_blank" rel="noopener noreferrer">WATCH ORIGINAL BUILD VIDEO ↗</a>}{guide.video&&!guide.source&&<small>Video by {guide.video.creator}; it demonstrates the creator's hardware, not this MAKHEX kit.</small>}</div></section>
<section class="container project-body-grid"><div><div class="content-section" id="bill-of-materials"><span class="eyebrow">01 / BILL OF MATERIALS</span><h2>What goes in.</h2>
{project.slug==='mosaico-learning-assistant' ? <MosaicoHardwareBOM/> : <><div class="bom-table"><div class="bom-row bom-heading"><span>COMPONENT</span><span>ROLE</span><span>QTY / ADD</span></div>{materials.map(m=><div class="bom-row" data-bom-mode={m.ali?'MAKHEX_ALI_20':'EXTERNAL_NO_MARKUP'}>
  <span class="bom-name-with-photo">
    <img src={'/product-media/'+m.slug+'.jpg'} width="46" height="46" loading="lazy" alt={'Component reference for '+(m.product?.title??m.slug)}/>
    {m.product?<a href={'/shop/'+m.slug+'/'}>{m.product.title} ↗</a>:m.slug}
    <small><a href={'/shop/'+m.slug+'/'}>PART DETAILS ↗</a></small>
  </span>
  <span>{m.why}{m.ali&&m.planned?<small class="bom-line-estimate">{formatUsd(m.planned.plannedRetailUsd*m.qty)} · 20% markup</small>:<small class="bom-line-estimate">External seller · no MAKHEX markup</small>}</span>
  <div class="bom-line-cart"><strong>{String(m.qty).padStart(2,'0')}</strong>
    {m.ali?<button type="button" data-cart-add data-cart-slug={m.slug} data-cart-option={m.planned?.title??'Option pending'} data-cart-project={project.slug} data-cart-quantity={m.qty} aria-label={'Add '+m.qty+' '+(m.product?.title??m.slug)+' to MAKHEX cart'}>ADD +</button>
    :m.direct?<a class="text-link" href={m.direct.url} target="_blank" rel="noopener noreferrer">VIEW SELLER ↗</a>
    :<a class="text-link" href={'/shop/'+m.slug+'/#buying-options'}>COMPARE SOURCES ↗</a>}
  </div>
</div>)}</div>
<div class="bom-total"><span>{materials.length} UNIQUE PART TYPES</span><span>{total} ITEMS</span></div>
<div class="project-cart-bar">
  {aliItems.length>0?<><button class="btn btn-primary" type="button" data-cart-add-all={project.slug}>ADD {aliQuantity} ALIEXPRESS PARTS TO MAKHEX CART +</button><a href="/cart/" class="btn btn-outline">VIEW MAKHEX CART ↗</a><a href="/checkout/" class="btn btn-primary">CHECK OUT WITH MAKHEX ↗</a></>:<p>All parts use direct manufacturer or retailer links; MAKHEX adds no markup.</p>}
</div><p data-cart-flash role="status" aria-live="polite"></p><div class="project-price-planner simple-project-subtotal"><span>MAKHEX AliExpress parts subtotal ({aliItems.length} types)</span><strong>{aliItems.length?formatUsd(plannedPartsSubtotal):'External suppliers only'}</strong></div>
<p class="project-price-note">AliExpress-listed parts use 20% markup on the documented supplier basis; final freight and inventory require approval. {externalItems.length} external types are linked directly with no MAKHEX markup and are not included in the subtotal or MAKHEX cart.</p>
</>}
{missingParts.length>0&&<div class="project-bom-gaps-simple"><strong>Still needed</strong><ul>{missingParts.map(gap=><li>{gap}</li>)}</ul></div>}
<BuildPartsChecklist project={project}/></div>
<div class="content-section"><span class="eyebrow">BEFORE POWER-UP</span><h2>Check these first.</h2><ul class="guide-checklist">{guide.beforeYouStart.map(s=><li>{s}</li>)}</ul></div>
<div class="content-section"><span class="eyebrow">02 / THE APPROACH</span><h2>Build sequence.</h2><ol class="steps-list">{project.steps.map((s,i)=><li><span>{String(i+1).padStart(2,'0')}</span><p>{s}</p></li>)}</ol></div>
<div class="content-section"><span class="eyebrow">SUCCESS CRITERIA</span><h2>Know when it works.</h2><ul class="guide-checklist">{guide.demoGoals.map(s=><li>{s}</li>)}</ul></div>
<div class="warning-box prominent"><strong>⚑ ENGINEERING NOTE</strong><p>{project.caution}</p><small>{isMicroduck?'The original robot is built and demonstrated; MAKHEX has not independently bench-tested a kit or source-matched substitute.':'Concept-stage plan; bench validation and firmware QA pending.'}</small></div></div>
<aside class="project-aside"><div class="aside-card"><span class="eyebrow">THE QUICK SPEC</span><div><span>STATUS</span><strong>{isMicroduck?'COMMUNITY BUILD / MAKHEX RESEARCH':'BLUEPRINT'}</strong></div><div><span>LEVEL</span><strong>{project.level.toUpperCase()}</strong></div><div><span>TIME</span><strong>{project.time.toUpperCase()}</strong></div><div><span>TECH</span><strong>{project.tech.join(' / ')}</strong></div></div>
<div class="aside-help"><span>FOR AI CODING AGENTS</span><p>Read the MAKHEX project README and compare the original maker's repo. Check the exact board, SDK, wiring and missing parts before editing firmware or suggesting replacements.</p><ul class="guide-agent-tasks">{guide.agentTasks.map(task=><li>{task}</li>)}</ul><a class="text-link" href={agentFile} target="_blank" rel="noopener noreferrer">OPEN PROJECT AGENT CONTEXT ↗</a></div>
<div class="aside-help"><span>FOUND A BETTER WAY?</span><p>Share a correction, alternative firmware or tested supplier option.</p><a class="text-link" href="#discussion">JOIN THIS PROJECT DISCUSSION ↓</a></div></aside></section>
<div class="container"><Discussion projectSlug={project.slug} context={project.title}/></div>
<section class="section container"><div class="section-heading compact"><div><span class="eyebrow">COMPATIBLE CANDIDATES</span><h2>The building blocks.</h2></div><a class="text-link" href="/shop/">FULL CATALOG ↗</a></div><div class="product-grid">{materials.map(m=>m.product&&<ProductCard product={m.product} projectSlug={project.slug}/>)}</div></section>
<script type="application/ld+json" set:html={JSON.stringify(ld)}/></BaseLayout>