---
import Base from '../../layouts/Base.astro';import Discussion from '../../components/Discussion.astro';import {projects} from '../../data/projects';import {products} from '../../data/catalog';
export function getStaticPaths(){return projects.map(p=>({params:{slug:p.slug},props:{project:p}}))};
const {project}=Astro.props;const needed=project.parts.map((slug:string)=>products.find(p=>p.slug===slug)).filter(Boolean);
---
<Base title={project.title} description={project.intro}><section class="page-banner detail-banner"><div class="wrap"><a class="back-link" href="/projects/">← All projects</a><div class="eyebrow">{project.label} / {project.level} / {project.time}</div><h1>{project.title}<span class="lime">.</span></h1><p>{project.intro}</p></div></section><section class="section"><div class="wrap detail-grid"><article class="longform"><div class="eyebrow">01 / THE BUILD</div><h2>From idea to <em>prototype.</em></h2><p class="note">Sprint 01 concept guide, not fully bench-tested wiring instructions. Verify module datasheets before applying power.</p><ol class="steps">{project.steps.map((s:string)=><li>{s}</li>)}</ol><h2>Before you power on</h2><p>{project.caution}</p><a href="https://github.com/polygoku/makhex/issues/new" class="text-link" target="_blank" rel="noopener">Suggest a build improvement ↗</a></article><aside class="bom"><div class="eyebrow">02 / YOUR WORKBENCH</div><h2>Parts list</h2><p>Research-stage BOM — availability and compatibility are not verified.</p>{needed.map((p:any)=><a class="bom-item" href={'/hardware/'+p.slug+'/'}><span class="bom-icon">⌁</span><span><b>{p.name}</b><small>View details ↗</small></span></a>)}<div class="bom-foot">Supplier-specific pin maps and verified checkout links are pending.</div></aside></div><div class="wrap"><Discussion title={project.title}/></div></section></Base>