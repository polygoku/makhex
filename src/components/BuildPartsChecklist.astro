---
import type {Project} from '../data/projects';
import {productBySlug} from '../lib/catalog';
interface Props { project:Project }
const {project}=Astro.props;
---
<section class="workbench-checklist" data-build-checklist data-project-slug={project.slug} aria-label={'Workbench checklist for '+project.title}>
  <div class="workbench-checklist-head">
    <div><span class="eyebrow">YOUR WORKBENCH / LOCAL CHECKLIST</span><h3>Gather your parts.</h3></div>
    <span class="workbench-checklist-stamp" aria-hidden="true">BOM / {project.number}</span>
  </div>
  <p class="workbench-checklist-intro">Tick parts you already have on hand. Your progress stays in this browser—no account needed.</p>
  <ul class="workbench-part-list">
    {project.materials.map((m) => {
      const part=productBySlug(m.slug);
      const id='have-'+project.slug+'-'+m.slug;
      return <li>
        <input id={id} type="checkbox" data-part-slug={m.slug} />
        <label for={id}><strong>{m.qty}× {part?.title??m.slug}</strong><span>{m.why}</span></label>
        <a href={'/shop/'+m.slug+'/'} aria-label={'Research '+(part?.title??m.slug)+' component details'}>Details <span aria-hidden="true">↗</span></a>
      </li>;
    })}
  </ul>
  <div class="workbench-checklist-footer">
    <p data-checklist-progress role="status" aria-live="polite">0 of {project.materials.length} part types checked</p>
    <button type="button" data-checklist-reset disabled>Clear checks</button>
  </div>
  <p class="workbench-checklist-disclaimer"><span aria-hidden="true">ⓘ</span> These are research-stage component candidates, not a verified kit. Checking a part does not establish electrical compatibility, supplier stock, or purchase eligibility.</p>
</section>
<script>
  const panels=document.querySelectorAll<HTMLElement>('[data-build-checklist]');
  for(const panel of panels){
    const slug=panel.dataset.projectSlug;
    if(!slug||!/^[a-z0-9-]+$/.test(slug))continue;
    const checkboxes=Array.from(panel.querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-part-slug]'));
    const progress=panel.querySelector<HTMLElement>('[data-checklist-progress]');
    const reset=panel.querySelector<HTMLButtonElement>('[data-checklist-reset]');
    if(!progress||!reset||!checkboxes.length)continue;
    const key='makhex:workbench:v1:'+slug;
    try{
      const data=JSON.parse(localStorage.getItem(key)||'[]');
      if(Array.isArray(data)){
        for(const checkbox of checkboxes){
          checkbox.checked=data.includes(checkbox.dataset.partSlug);
        }
      }
    }catch{/* Private mode or invalid storage: checklist remains usable in-memory */}
    function render(save:boolean){
      const marked=checkboxes.filter(x=>x.checked).map(x=>x.dataset.partSlug);
      progress!.textContent=marked.length+' of '+checkboxes.length+' part types checked';
      reset!.disabled=marked.length===0;
      if(save){
        try{localStorage.setItem(key,JSON.stringify(marked));}catch{/* Storage is optional */}
      }
    }
    checkboxes.forEach(x=>x.addEventListener('change',()=>render(true)));
    reset.addEventListener('click',()=>{
      checkboxes.forEach(x=>{x.checked=false;});
      render(true);
      checkboxes[0]?.focus();
    });
    render(false);
  }
</script>
