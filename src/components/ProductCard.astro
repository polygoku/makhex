---
import type {Product} from '../data/products';
import ProductPhoto from './ProductPhoto.astro';
import {productUrl} from '../lib/catalog';
import {stageFor,plannedVariantForProject,formatUsd} from '../data/catalog-staging';
interface Props{product:Product;projectSlug?:string}
const {product,projectSlug}=Astro.props;
const stage=stageFor(product.slug);
const minimum=stage?Math.min(...stage.variants.map(v=>v.plannedRetailUsd)):null;
const intended=plannedVariantForProject(product.slug,projectSlug);
---
<article class="product-card product-card-v2 product-card-simple">
  <a class="product-card-image" href={productUrl(product.slug)} aria-label={'Explore '+product.title}>
    <ProductPhoto product={product}/>
  </a>
  <div class="simple-product-info">
    <a class="product-title-link" href={productUrl(product.slug)}><h3>{stage?.supplierModel??product.title}</h3></a>
    <div class="simple-product-price">
      <strong>{minimum!==null?formatUsd(minimum):'Compare sellers'}</strong>
      {stage&&stage.variants.length>1&&<span>from</span>}
    </div>
    <a href={productUrl(product.slug)+'#buying-options'} class="text-link">SELLER LINKS ↗</a>
  </div>
  <div class="cart-card-action"><button type="button" data-cart-add data-cart-slug={product.slug} data-cart-project={projectSlug} data-cart-option={intended?.title??'Option pending'} data-cart-quantity="1">Add to parts cart +</button></div>
</article>