---
import type {Product} from '../data/products';
import ProductPhoto from './ProductPhoto.astro';
import {productUrl} from '../lib/catalog';
import {stageFor,plannedVariantForProject,formatUsd} from '../data/catalog-staging';
import {isMakhexAliExpress,preferredExternalOffer} from '../data/sourcing-policy';
interface Props{product:Product;projectSlug?:string}
const {product,projectSlug}=Astro.props;
const isAli=isMakhexAliExpress(product.slug);
const stage=isAli?stageFor(product.slug):undefined;
const minimum=stage?Math.min(...stage.variants.map(v=>v.plannedRetailUsd)):null;
const intended=isAli?plannedVariantForProject(product.slug,projectSlug):undefined;
const external=isAli?undefined:preferredExternalOffer(product.slug,projectSlug);
---
<article class="product-card product-card-v2 product-card-simple" data-source-mode={isAli?'MAKHEX_ALI_20':'EXTERNAL_NO_MARKUP'}>
  <a class="product-card-image" href={productUrl(product.slug)} aria-label={'Explore '+product.title}>
    <ProductPhoto product={product}/>
  </a>
  <div class="simple-product-info">
    <a class="product-title-link" href={productUrl(product.slug)}><h3>{stage?.supplierModel??product.title}</h3></a>
    <div class="simple-product-price">
      <strong>{isAli&&minimum!==null?'MAKHEX plan '+formatUsd(minimum):'External supplier · no markup'}</strong>
      {isAli&&stage&&stage.variants.length>1&&<span>from</span>}
    </div>
    <a href={productUrl(product.slug)} class="text-link">PART DETAILS ↗</a>
  </div>
  <div class="cart-card-action">{isAli?
    <button type="button" data-cart-add data-cart-slug={product.slug} data-cart-project={projectSlug} data-cart-option={intended?.title??stage?.variants[0]?.title??'Option pending'} data-cart-quantity="1">Add to MAKHEX cart +</button>
    :external?<a class="btn btn-outline" href={external.url} target="_blank" rel="noopener noreferrer">VIEW AT {external.seller.toUpperCase()} ↗</a>
    :<a class="btn btn-outline" href={productUrl(product.slug)+'#buying-options'}>COMPARE EXTERNAL SELLERS ↗</a>}
  </div>
</article>
