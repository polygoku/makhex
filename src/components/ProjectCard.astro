---
import type{Project} from '../data/projects';
import {projectUrl} from '../lib/catalog';
import ProjectArtwork from './ProjectArtwork.astro';
import ProductPhoto from './ProductPhoto.astro';
import {productBySlug} from '../lib/catalog';
import {buildReferences} from '../data/build-references';
interface Props{project:Project}
const {project}=Astro.props;
const reference=buildReferences[project.slug];
const mosaicoHardware=project.slug==='mosaico-learning-assistant'?productBySlug('esp-mosaico-vision-combo-kit'):undefined;
---
<article class="project-card">
  <a href={projectUrl(project.slug)} class="project-card-link" aria-label={'View project '+project.title}>
    <div class="project-card-top"><span class="project-category">{project.category}</span><span class="project-number">BUILD {project.number}</span></div>
    {reference ? <div class="real-reference-card-image"><img src={reference.image} alt={reference.alt} loading="lazy" width="760" height="520"/><span class="real-reference-card-stage">Photo: {reference.builder}</span></div> : mosaicoHardware ? <div class="real-reference-card-image"><img src="/demo/build11-english-lifestyle-wide.jpg" alt="English AI learning assistant concept image; AI-generated, not a product photograph" loading="lazy" width="1122" height="701"/><span class="real-reference-card-stage">English concept illustration · not a product photo</span></div> : <ProjectArtwork project={project}/>}
    <div class="project-card-bottom">
      <div class="project-card-tags"><span>{project.level}</span><span class="tag-divider" aria-hidden="true">·</span><span>{project.time}</span></div>
      <div class="project-card-title-row"><h3>{project.title}</h3><span class="card-arrow" aria-hidden="true">↗</span></div>
      <p>{project.summary}</p>
      <span class="card-cta">See build &amp; parts list <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>
