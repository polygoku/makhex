---
import type {Project} from '../data/projects';
import ProjectArtwork from './ProjectArtwork.astro';
import {productBySlug,productUrl} from '../lib/catalog';
interface Props{project:Project;total:number}
const {project,total}=Astro.props;
const weatherScene=project.slug==='touch-weather-station';
const isMosaico=project.slug==='mosaico-learning-assistant';
const isMicroduck=project.slug==='microduck-robot';
const leadPart=project.materials[0]?productBySlug(project.materials[0].slug):undefined;
---
<article class="featured-build" aria-labelledby="featured-build-name">
  <div class="featured-build-head">
    <span class="feature-stamp"><span class="tiny-indicator" aria-hidden="true"></span> LATEST BUILD / FROM THE WORKBENCH</span>
    <span class="feature-count">BUILD {project.number} / {String(total).padStart(2,'0')}</span>
  </div>
  <div class:list={['featured-build-image',{'featured-build-latest':!weatherScene,'build11-featured-photo':isMosaico}]}>
    {weatherScene
      ? <>
        <img src="/workbench-scene.svg" width="800" height="580" alt="Concept rendering of an ESP32 touch weather station with a knob and sensor board on a cutting mat." decoding="async" fetchpriority="high"/>
        <a class="pin-label pin-one" href="/shop/esp32-s3-devkit/" aria-label="Explore ESP32-S3 Dev Board research details">ESP32-S3 <span class="pin-dot" aria-hidden="true"></span></a>
        <a class="pin-label pin-two" href="/shop/bme280-sensor/" aria-label="Explore BME280 environment sensor research details">BME280 sensor <span class="pin-dot" aria-hidden="true"></span></a>
      </>
      : isMicroduck ? <>
        <img src="/demo/microduck/microduck-hero.jpg" alt="Real Microduck biped robot created by kissqy in a video demonstration" width="960" height="540" decoding="async" fetchpriority="high"/>
        {leadPart&&<a class="pin-label pin-one" href={productUrl(leadPart.slug)} aria-label={'Research '+leadPart.title}>{leadPart.title}<span class="pin-dot" aria-hidden="true"></span></a>}
      </>
      : isMosaico ? <>
        <img src="/demo/build11-english-lifestyle-wide.jpg" alt="Illustrative English-language AI learning assistant scanning a math problem on a worksheet" width="1122" height="701" decoding="async" fetchpriority="high"/>
        {leadPart&&<a class="pin-label pin-one" href={productUrl(leadPart.slug)} aria-label={'Explore '+leadPart.title}>{leadPart.title}<span class="pin-dot" aria-hidden="true"></span></a>}
      </> : <>
        <ProjectArtwork project={project}/>
        {leadPart&&<a class="pin-label pin-one" href={productUrl(leadPart.slug)} aria-label={'Explore research details for '+leadPart.title}>{leadPart.title}<span class="pin-dot" aria-hidden="true"></span></a>}
      </>
    }
    <span class="visual-disclaimer">{isMicroduck?'Actual Microduck footage · kissqy / not a MAKHEX-assembled kit':isMosaico?'English UI concept · AI-generated illustration, not device footage':'Concept illustration · not a verified product photo'}</span>
  </div>
  <div class="featured-build-footer">
    <div>
      <span class="feature-eyebrow">NEWEST PROJECT <span class="separator">/</span> {project.level} <span class="separator">/</span> {project.materials.length} part types</span>
      <h2 id="featured-build-name">{project.title}</h2>
      <p>{project.signal} → {project.output}. Research blueprint; parts and firmware are not yet fully qualified.</p>
    </div>
    <a class="feature-next" href={'/projects/'+project.slug+'/'} aria-label={'Explore '+project.title}><span aria-hidden="true">→</span></a>
  </div>
  <details class="feature-bom">
    <summary><span>What's inside this build?</span><span class="summary-toggle" aria-hidden="true">+</span></summary>
    <ol>
      {project.materials.map(m=><li><span>{m.qty}×</span><span>{m.why}</span></li>)}
    </ol>
    <a href={'/projects/'+project.slug+'/'}>Open full parts list <span aria-hidden="true">→</span></a>
  </details>
</article>
