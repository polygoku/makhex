---
import type {Product} from '../data/products';
interface Props{product:Product;large?:boolean;gallery?:boolean}
const {product,large=false,gallery=false}=Astro.props;
const isMicroduckDrawing=['feetech-hd1910','radxa-zero-3w','microduck-hat','microduck-imu','imx219-160-camera','vl53l5cx-v2','npf550-power-kit','bearing-6700','bearing-et2216','bearing-623zz','microduck-printed-parts','microduck-fasteners','amp20-servo-cables','microduck-wiring-kit'].includes(product.slug);
---
<div class:list={['supplier-media',{'supplier-media-large':large}]} data-supplier-reference-image={product.slug}>
 <img src={'/product-media/'+product.slug+'.jpg'} alt={isMicroduckDrawing?'MAKHEX technical component illustration for '+product.title+'. Not a supplier product photo.':'Supplier listing reference photo for '+product.title+'. Exact variant not verified.'} loading={large?'eager':'lazy'} decoding="async" width="900" height="900"/>
 {gallery&&<a class="supplier-media-original" href={'/product-media/'+product.slug+'.jpg'} target="_blank" rel="noopener noreferrer">VIEW LARGER IMAGE ↗</a>}
</div>
